{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-firearm-identity-ai-response-v1",
  "title": "Forge firearm identity AI response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requested_identity",
    "classification",
    "canonical_name",
    "confidence",
    "identity_evidence",
    "visual_description_en",
    "required_identity_parts_zh",
    "declaration"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "forge-firearm-identity-ai-response-v1"
    },
    "requested_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "classification": {
      "type": "string",
      "enum": [
        "handheld_firearm_supported",
        "handheld_firearm_unsupported",
        "vehicle_weapon_platform",
        "not_firearm",
        "unknown"
      ]
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "identity_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "visual_description_en": {
      "type": "string",
      "maxLength": 360
    },
    "required_identity_parts_zh": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weapon_domain",
        "layout",
        "stock_structure",
        "feed_position",
        "magazine_shape",
        "barrel_length",
        "upper_profile",
        "support_mode",
        "fire_control",
        "cadence",
        "recoil",
        "accuracy",
        "reload",
        "effective_range",
        "handling",
        "magazine_capacity",
        "finish_palette"
      ],
      "properties": {
        "weapon_domain": {
          "type": "string",
          "enum": ["handheld_firearm", "not_applicable"]
        },
        "layout": {
          "type": "string",
          "enum": ["bullpup", "conventional_rifle", "pistol", "not_applicable"]
        },
        "stock_structure": {
          "type": "string",
          "enum": ["integrated", "telescoping", "fixed", "none", "not_applicable"]
        },
        "feed_position": {
          "type": "string",
          "enum": ["behind_grip", "ahead_of_grip", "in_grip", "not_applicable"]
        },
        "magazine_shape": {
          "type": "string",
          "enum": ["straight", "curved", "in_grip", "not_applicable"]
        },
        "barrel_length": {
          "type": "string",
          "enum": ["short", "medium", "long", "not_applicable"]
        },
        "upper_profile": {
          "type": "string",
          "enum": ["carry_handle", "top_rail", "raised_gas_tube", "slide", "not_applicable"]
        },
        "support_mode": {
          "type": "string",
          "enum": ["one_hand", "two_hand_shouldered", "not_applicable"]
        },
        "fire_control": {
          "type": "string",
          "enum": ["semi_auto", "select_fire_auto", "not_applicable"]
        },
        "cadence": {
          "type": "string",
          "enum": ["deliberate", "balanced", "rapid", "not_applicable"]
        },
        "recoil": {
          "type": "string",
          "enum": ["light", "medium", "strong", "not_applicable"]
        },
        "accuracy": {
          "type": "string",
          "enum": ["precise", "controlled", "loose", "not_applicable"]
        },
        "reload": {
          "type": "string",
          "enum": ["quick", "standard", "slow", "not_applicable"]
        },
        "effective_range": {
          "type": "string",
          "enum": ["short", "medium", "long", "not_applicable"]
        },
        "handling": {
          "type": "string",
          "enum": ["agile", "balanced", "heavy", "not_applicable"]
        },
        "magazine_capacity": {
          "type": "string",
          "enum": ["compact", "standard", "extended", "not_applicable"]
        },
        "finish_palette": {
          "type": "string",
          "enum": ["gunmetal_black", "olive_black", "wood_steel", "dark_polymer", "not_applicable"]
        }
      }
    }
  }
}
