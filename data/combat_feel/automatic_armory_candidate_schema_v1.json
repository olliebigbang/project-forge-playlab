{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge automatic armory candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_role",
    "canonical_name",
    "common_alias",
    "selection_reason_zh",
    "confidence"
  ],
  "properties": {
    "schema": {
      "const": "forge-automatic-armory-candidate-v1"
    },
    "target_role": {
      "type": "string",
      "enum": [
        "close_quarters",
        "precision",
        "sidearm",
        "scatter",
        "support",
        "service"
      ]
    },
    "canonical_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "common_alias": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "selection_reason_zh": {
      "type": "string",
      "minLength": 8,
      "maxLength": 180
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
