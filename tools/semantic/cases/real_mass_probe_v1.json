{
  "schema": "forge-real-mass-probe-v1",
  "purpose": "Measure whether the model can estimate real object mass reliably enough to drive tempo. Reference values are rough human estimates with a tolerance band, NOT ground truth -- the load-bearing checks are repeat spread, ordering, and the two control pairs, none of which depend on the reference being exactly right. Identities are copied verbatim from real_length_probe_v1.json so both axes are asked about exactly the same objects.",
  "control_pairs": [
    {
      "plain": "wooden_spoon",
      "modified": "iron_bar",
      "asserts": "mass is not recoverable from length: both are ~30cm one-hand objects, and only the substance differs. The size is stated in silhouette_hints because the estimator is deliberately not given real_length_cm -- without it the model priced a bar of its own choosing and the pair stopped being a controlled one."
    },
    {
      "plain": "wooden_spoon",
      "modified": "giant_wooden_spoon",
      "asserts": "the model reads the size modifier in display_name rather than pattern-matching the noun -- the P06 defect, guarded on the mass axis too."
    }
  ],
  "known_objects": [
    "frying_pan",
    "giant_wooden_spoon",
    "shotgun_melee",
    "old_mop"
  ],
